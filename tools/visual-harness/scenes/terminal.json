{
  "id": "terminal",
  "profile": "arch-hyprland",
  "description": "Ghostty/Zsh on deterministic fixture directory",
  "mode": "1600x900@60",
  "wait_seconds": 3,
  "argv": [
    "ghostty",
    "--working-directory={fixture}"
  ],
  "window_class": "com.mitchellh.ghostty",
  "pixel_delta_threshold": 24,
  "ignore_regions": [
    [
      0,
      0,
      1600,
      44
    ]
  ],
  "visual_limits": {
    "mean_abs": 0.08,
    "changed_fraction": 0.18
  },
  "functional_tests": [
    "shell prompt visible",
    "copy and paste",
    "Unicode and Nerd Font rendering",
    "long command wrapping",
    "tmux interaction"
  ]
}
