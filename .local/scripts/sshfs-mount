#!/usr/bin/env bash

set -e

usage() {
    cat <<EOF
Usage: sshfs-mount [OPTIONS] [local:remote]

Mount a remote folder via SSHFS.

Options:
    -a, --account <user>    SSH account/username

Arguments:
    local:remote           Mount specification (e.g., ~/local:~/remote)
                          If omitted, runs in interactive mode
    local                  Just local path → prompts for remote folder

Examples:
    sshfs-mount -a nyxze
    sshfs-mount -a nyxze ~/stuff/emobot/mobile:~/Dev/RemoteFolder
    sshfs-mount -a nyxze ~/stuff/emobot/mobile    # selects remote interactively
EOF
    exit 1
}

get_target() {
    awk 'NR>1 && $3=="0x2" {print $1}' /proc/net/arp | while read ip; do
        name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
        echo "$ip ${name:-unknown}"
    done | fzf --prompt="Select device: " | awk '{print $1}'
}

get_local_folder() {
    find . -maxdepth 3 -type d | fzf --prompt="Select local folder: "
}

get_remote_folder() {
    local user_host="$1"
    # Added -n to prevent ssh from reading from the terminal
    ssh -n -o ConnectTimeout=10 "$user_host" 'find ~ -maxdepth 3 -type d 2>/dev/null' | fzf --prompt="Select remote folder: "
}

ACCOUNT=""
MOUNT_SPEC=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--account)
            ACCOUNT="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            MOUNT_SPEC="$1"
            shift
            ;;
    esac
done

TARGET=$(get_target)

if [[ -z "$TARGET" ]]; then
    echo "No target selected."
    exit 1
fi

if [[ -n "$ACCOUNT" ]]; then
    USER_HOST="${ACCOUNT}@${TARGET}"
else
    USER_HOST="${TARGET}"
fi

if [[ -n "$MOUNT_SPEC" ]]; then
    if [[ "$MOUNT_SPEC" == *:* ]]; then
        LOCAL_PATH="${MOUNT_SPEC%:*}"
        REMOTE_PATH="${MOUNT_SPEC#*:}"
        
        LOCAL_PATH="${LOCAL_PATH/#\~/$HOME}"
        REMOTE_PATH="${REMOTE_PATH/#\~/$HOME}"
    else
        LOCAL_PATH="${MOUNT_SPEC/#\~/$HOME}"
        
        echo "Select remote folder..."
        REMOTE_PATH=$(get_remote_folder "$USER_HOST")
        
        if [[ -z "$REMOTE_PATH" ]]; then
            echo "No remote folder selected."
            exit 1
        fi
    fi
else
    LOCAL_PATH=$(get_local_folder)
    
    if [[ -z "$LOCAL_PATH" ]]; then
        echo "No local folder selected."
        exit 1
    fi
    
    REMOTE_PATH=$(get_remote_folder "$USER_HOST")
    
    if [[ -z "$REMOTE_PATH" ]]; then
        echo "No remote folder selected."
        exit 1
    fi
fi

echo "Mounting ${USER_HOST}:${REMOTE_PATH} -> ${LOCAL_PATH}"
mkdir -p "$LOCAL_PATH"
sshfs "${USER_HOST}:${REMOTE_PATH}" "$LOCAL_PATH"

echo "Mount complete!"
