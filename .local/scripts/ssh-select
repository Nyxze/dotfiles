#!/usr/bin/env bash

USER="${1:-}"

TARGET=$(awk 'NR>1 && $3=="0x2" {print $1}' /proc/net/arp | while read ip; do
    name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
    echo "$ip ${name:-unknown}"
done | fzf --prompt="Select device: " | awk '{print $1}')

if [[ -n "$TARGET" ]]; then
    if [[ -n "$USER" ]]; then
        HOST_USER=$(whoami) ssh "${USER}@${TARGET}"
    else
        HOST_USER=$(whoami) ssh "$TARGET"
    fi
fi
