#!/usr/bin/env bash

USER="${1:-}"

_resolve() {
    local ip="$1"
    local name
    name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
    echo "$ip ${name:-unknown}"
}

_scan_lan() {
    # Detect LAN subnets (skip docker/loopback)
    local subnets
    subnets=$(ip route show | awk '/scope link/ && $1!~/^172\.|^127\./ {print $1}' | sort -u)

    # Seed with ARP cache (instant)
    awk 'NR>1 && $3=="0x2" {print $1}' /proc/net/arp

    # Active nmap ping scan of each LAN subnet
    for subnet in $subnets; do
        nmap -sn --host-timeout 2s "$subnet" 2>/dev/null \
            | awk '/Nmap scan report for/{
                if (match($NF, /\(([0-9.]+)\)/, m)) print m[1]
                else if ($NF ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $NF
            }'
    done
}

TARGET=$( (
    declare -A seen
    while read -r ip; do
        [[ -z "$ip" || -n "${seen[$ip]}" ]] && continue
        seen[$ip]=1
        _resolve "$ip"
    done < <(_scan_lan)
) | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n \
  | fzf --prompt="Select device: " | awk '{print $1}')

if [[ -n "$TARGET" ]]; then
    if [[ -n "$USER" ]]; then
        HOST_USER=$(whoami) ssh "${USER}@${TARGET}"
    else
        HOST_USER=$(whoami) ssh "$TARGET"
    fi
fi
