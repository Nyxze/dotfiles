#!/usr/bin/env bash
# Session switcher: pick a live session, an SSH host from ~/.ssh/config, or
# type a name that matches nothing to create it.
#
# A name given as an argument skips the picker, which is what makes it
# scriptable and testable — `tmux-sessions dotfiles` goes straight there.
set -uo pipefail

switch() {
    if [ -z "${TMUX:-}" ]; then
        tmux attach-session -t "$1"
    else
        tmux switch-client -t "$1"
    fi
}

open_session() {
    local name="$1"
    tmux has-session -t="$name" 2>/dev/null || tmux new-session -ds "$name" -c "$HOME"
    switch "$name"
}

open_host() {
    local host="$1"
    if ! tmux has-session -t="$host" 2>/dev/null; then
        tmux new-session -ds "$host"
        tmux send-keys -t "$host" "ssh $host" C-m
    fi
    switch "$host"
}

# Wildcard patterns are rules rather than destinations, so they are dropped.
hosts() {
    [ -f "$HOME/.ssh/config" ] || return 0
    awk 'tolower($1) == "host" {
        for (i = 2; i <= NF; i++)
            if ($i !~ /[*?!]/)
                print $i
    }' "$HOME/.ssh/config"
}

if [ $# -gt 0 ]; then
    if hosts | grep -qx "$1"; then
        open_host "$1"
    else
        open_session "$1"
    fi
    exit 0
fi

current=$(tmux display-message -p '#S' 2>/dev/null)

rows() {
    local name windows mark host
    while IFS=$'\t' read -r name windows; do
        [ -n "$name" ] || continue
        mark=" "
        [ "$name" = "$current" ] && mark=">"
        printf 'session:%s\t%s\t󰆍\t%s\t%s\n' "$name" "$mark" "$name" "$windows"
    done < <(tmux list-sessions -F '#{session_name}	#{session_windows}w' 2>/dev/null)

    # A host already holding a session is that session, not a second way in.
    while read -r host; do
        [ -n "$host" ] || continue
        tmux has-session -t="$host" 2>/dev/null && continue
        printf 'host:%s\t \t󰒋\t%s\tssh\n' "$host" "$host"
    done < <(hosts)

    printf 'action:scan\t \t󰛳\tScan the network…\tC-r\n'
}

mapfile -t out < <(rows | tmux-picker 'Filter or create…' ctrl-n,ctrl-r,ctrl-x 1 '' '' \
    'Ctrl-n new session · Ctrl-r scan network · Ctrl-x kill session')

query="${out[0]:-}"
key="${out[1]:-}"
pick="${out[2]:-}"

# The action keys work wherever the cursor happens to be.
case "$key" in
    ctrl-n) open_session "${query:-$(basename "$PWD")}"; exit 0 ;;
    ctrl-r) tmux-ssh; exit 0 ;;
    ctrl-x) [[ "$pick" = session:* ]] && tmux kill-session -t "${pick#session:}"; exit 0 ;;
esac

case "$pick" in
    session:*) switch "${pick#session:}" ;;
    host:*) open_host "${pick#host:}" ;;
    action:scan) tmux-ssh ;;
    # Nothing picked: the query matched no row, which is the create case.
    *) [ -n "$query" ] && open_session "${query// /_}" ;;
esac
