# Endfield theme for btop.
#
# Load ramps run calm to loud — success, accent, danger — while anything that
# measures headroom rather than pressure stays on the neutrals, and anything
# informational stays blue. That is the same division the rest of the desktop
# uses, so a busy CPU here reads like a warning anywhere else.

theme[main_bg]="#0B1118"
theme[main_fg]="#E8EDF1"
theme[title]="#E8EDF1"
theme[hi_fg]="#FFD400"
theme[selected_bg]="#1B2733"
theme[selected_fg]="#FFD400"
theme[inactive_fg]="#8A99A6"
theme[graph_text]="#AAB7C2"
theme[meter_bg]="#1B2733"
theme[proc_misc]="#4B9BFF"

theme[cpu_box]="#1B2733"
theme[mem_box]="#1B2733"
theme[net_box]="#1B2733"
theme[proc_box]="#1B2733"
theme[div_line]="#3A4A59"

theme[temp_start]="#4B9BFF"
theme[temp_mid]="#FFD400"
theme[temp_end]="#FF6B45"

theme[cpu_start]="#8BD32E"
theme[cpu_mid]="#FFD400"
theme[cpu_end]="#FF6B45"

theme[free_start]="#3A4A59"
theme[free_mid]="#8A99A6"
theme[free_end]="#AAB7C2"

theme[cached_start]="#3A4A59"
theme[cached_mid]="#4B9BFF"
theme[cached_end]="#7CB8FF"

theme[available_start]="#8A99A6"
theme[available_mid]="#AAB7C2"
theme[available_end]="#E8EDF1"

theme[used_start]="#8BD32E"
theme[used_mid]="#FFD400"
theme[used_end]="#FF6B45"

theme[download_start]="#3A4A59"
theme[download_mid]="#4B9BFF"
theme[download_end]="#7CB8FF"

theme[upload_start]="#3A4A59"
theme[upload_mid]="#FFD400"
theme[upload_end]="#FFE14D"

theme[process_start]="#8BD32E"
theme[process_mid]="#FFD400"
theme[process_end]="#FF6B45"
