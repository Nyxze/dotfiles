{
    "include": [
        "$HOME/.config/waybar/Modules",
        "$HOME/.config/waybar/ModulesGroups"
    ],
    "layer": "top",
    "reload_style_on_change": true,
    "position": "top",
    "ext/workspaces": {
        "active-only": false,
        "all-outputs": false,
        "format": "{name}",
        "ignore-hidden": true,
        "on-click": "activate",
        "sort-by-name": true
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "qs -c endfield ipc call sidebar page power",
        "tooltip": true,
        "tooltip-format": "Session"
    },
    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "group/status",
        "custom/control",
        "clock",
        "tray",
        "custom/power"
    ],
    "custom/control": {
        "format": "󰒓",
        "on-click": "qs -c endfield ipc call sidebar toggle",
        "tooltip": true,
        "tooltip-format": "Control centre"
    }
}
