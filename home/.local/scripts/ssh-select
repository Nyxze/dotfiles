#!/usr/bin/env bash

set -uo pipefail

print_target=0
if [[ "${1:-}" == "--print" ]]; then
    print_target=1
    shift
fi

account="${1:-}"

_resolve() {
    local ip="$1"
    local name
    name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}')
    echo "$ip ${name:-unknown}"
}

_scan_lan() {
    # Detect LAN subnets (skip docker/loopback)
    local subnets
    subnets=$(ip route show | awk '/scope link/ && $1!~/^172\.|^127\./ {print $1}' | sort -u)

    # Only offer devices that accept the standard SSH port.
    for subnet in $subnets; do
        nmap -n -p 22 --open --host-timeout 2s "$subnet" 2>/dev/null \
            | awk '/Nmap scan report for/{
                if (match($NF, /\(([0-9.]+)\)/, m)) print m[1]
                else if ($NF ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $NF
            }'
    done
}

target=$( (
    declare -A seen
    while read -r ip; do
        [[ -z "$ip" || -n "${seen[$ip]}" ]] && continue
        seen[$ip]=1
        _resolve "$ip"
    done < <(_scan_lan)
) | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n \
  | fzf --prompt="Select device: " | awk '{print $1}')

[[ -n "$target" ]] || exit 0

if [[ -n "$account" ]]; then
    target="${account}@${target}"
fi

if [[ "$print_target" -eq 1 ]]; then
    printf '%s\n' "$target"
    exit 0
fi

ssh -- "$target"
