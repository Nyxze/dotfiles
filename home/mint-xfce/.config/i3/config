set $mod Mod4
set $ws0 0
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5

# Keep the Mint/i3 session's workspace layout aligned with Hyprland: Super+0
# is the laptop workspace and Super+1…5 belong to an external display.
# i3 selects the first active XRandR output in this list, so this covers every
# external connector exposed by this machine without a watcher or polling.
set $laptop_output eDP
set $external_outputs HDMI-A-0 DisplayPort-0 DisplayPort-1 DisplayPort-2 DisplayPort-3 DisplayPort-4 DisplayPort-5 DisplayPort-6
workspace $ws0 output $laptop_output
workspace $ws1 output $external_outputs
workspace $ws2 output $external_outputs
workspace $ws3 output $external_outputs
workspace $ws4 output $external_outputs
workspace $ws5 output $external_outputs

font pango:JetBrainsMono Nerd Font 10

# Match the Hyprland profile as closely as i3 allows: square 2px borders,
# 2px between tiled clients, 4px at workspace edges, and the Endfield focus
# palette. Hyprland also uses no rounding, shadow, or blur.
default_border pixel 2
default_floating_border pixel 2
for_window [window_type="normal"] border pixel 2
for_window [title="^endfield-"] floating enable, border none
exec_always --no-startup-id i3-msg '[window_type="normal"] border pixel 2'
gaps inner 2
gaps outer 4

client.focused          #FFD400 #0B1118 #E8EDF1 #FFD400 #FFD400
client.focused_inactive #3A4A59 #0B1118 #AAB7C2 #3A4A59 #3A4A59
client.unfocused        #3A4A59 #0B1118 #8A99A6 #3A4A59 #3A4A59
client.urgent           #FF6B45   #0B1118 #E8EDF1 #FF6B45   #FF6B45
client.background       #0B1118

floating_modifier $mod
tiling_drag modifier
focus_follows_mouse no
# Repeating Super+<number> must leave the current workspace unchanged.
workspace_auto_back_and_forth no

# Xfce still owns the session services; i3 owns the visible panel in this
# session. xfdesktop's desktop window otherwise floats above tiled clients.
# Xfce assigns bare Super to its menu by default, preventing i3 shortcuts.
exec --no-startup-id xfconf-query -c xfce4-keyboard-shortcuts -p /commands/custom/Super_L -r
exec_always --no-startup-id xfdesktop --quit
exec_always --no-startup-id xfce4-panel --quit
exec_always --no-startup-id feh --bg-fill ~/.config/theme/greeter.png
exec_always --no-startup-id xsetroot -cursor_name left_ptr
# Quickshell owns the single reserved top bar on every XRandR output.

exec --no-startup-id sh -c 'export I3SOCK="$(i3 --get-socketpath)"; exec "$HOME/.nix-profile/bin/qs" -c endfield'

bindsym $mod+Return exec alacritty
bindsym $mod+e exec nautilus
bindsym $mod+f exec rofi -show drun
bindsym $mod+F1 exec ~/.nix-profile/bin/qs -c endfield ipc call shortcuts toggle
bindsym $mod+b exec brave-browser
bindsym $mod+n exec code
bindsym $mod+Shift+l exec xflock4
bindsym Ctrl+Mod1+Delete exec xfce4-session-logout

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+v floating toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+F4 kill

# Hyprland uses Super + mouse drag for window manipulation. i3 mirrors that
# for moving tiled/floating windows and resizing floating windows; tiled
# containers are resized directly with these bindings (or by dragging a border).
bindsym $mod+Ctrl+h resize shrink width 5 ppt or 10 px
bindsym $mod+Ctrl+j resize grow height 5 ppt or 10 px
bindsym $mod+Ctrl+k resize shrink height 5 ppt or 10 px
bindsym $mod+Ctrl+l resize grow width 5 ppt or 10 px
bindsym $mod+Ctrl+Left resize shrink width 5 ppt or 10 px
bindsym $mod+Ctrl+Down resize grow height 5 ppt or 10 px
bindsym $mod+Ctrl+Up resize shrink height 5 ppt or 10 px
bindsym $mod+Ctrl+Right resize grow width 5 ppt or 10 px

bindsym $mod+0 workspace number $ws0
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+Shift+0 move container to workspace number $ws0
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

bindsym $mod+Tab exec ~/.nix-profile/bin/qs -c endfield ipc call overview next
bindsym $mod+Shift+Tab exec ~/.nix-profile/bin/qs -c endfield ipc call overview previous
bindsym $mod+d exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar toggle
bindsym $mod+Ctrl+c exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar page clipboard
bindsym $mod+Ctrl+a exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar page output
bindsym $mod+Ctrl+m exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar page input
bindsym $mod+Ctrl+w exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar page network
bindsym $mod+Ctrl+b exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar page bluetooth
bindsym $mod+Ctrl+d exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar page calendar
bindsym $mod+Ctrl+p exec ~/.nix-profile/bin/qs -c endfield ipc call sidebar page power

bindsym Print exec xfce4-screenshooter -f
bindsym $mod+Shift+s exec xfce4-screenshooter -r

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

exec --no-startup-id setxkbmap -layout us -variant altgr-intl -option caps:ctrl_modifier
