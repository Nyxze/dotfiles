#!/usr/bin/env python3
"""Set the Arch Endfield image as an opaque X11 root wallpaper."""

import os
from pathlib import Path
import re
import subprocess
import sys


def main():
    source = Path.home() / ".config/theme/greeter.png"
    if not source.is_file():
        print(f"i3-wallpaper: missing {source}", file=sys.stderr)
        return 1

    root = subprocess.run(
        ["xwininfo", "-root"], capture_output=True, text=True, check=True
    ).stdout
    width = re.search(r"^\s*Width:\s*(\d+)$", root, re.MULTILINE)
    height = re.search(r"^\s*Height:\s*(\d+)$", root, re.MULTILINE)
    if not width or not height:
        print("i3-wallpaper: cannot determine root size", file=sys.stderr)
        return 1

    size = f"{width[1]}x{height[1]}"
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    wallpaper = cache / "dotfiles/mint-i3-wallpaper.png"
    wallpaper.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        [
            "convert", str(source), "-background", "#0B1118", "-alpha", "remove",
            "-alpha", "off", "-resize", size + "^", "-gravity", "center",
            "-extent", size, str(wallpaper),
        ],
        check=True,
    )
    # ImageMagick sets the pixmap successfully but returns 1 for a root target.
    subprocess.run(["display", "-window", "root", str(wallpaper)], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
