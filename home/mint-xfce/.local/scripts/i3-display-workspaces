#!/usr/bin/env python3
"""Keep Mint/i3 workspaces on the same displays as the Hyprland profile.

Workspace 0 is the laptop desktop. Workspaces 1-5 follow the first active
external output, and fall back to the laptop when disconnected.
"""
import json
import logging
import subprocess
import time

LOG = logging.getLogger("i3-displays")
POLL_SECONDS = 1


def i3(*args):
    return subprocess.run(["i3-msg", *args], check=True, capture_output=True, text=True)


def state(kind):
    return json.loads(i3("-t", "get_" + kind).stdout)


def internal_output(outputs):
    active = [o["name"] for o in outputs if o.get("active")]
    return next((name for name in active if name.startswith(("eDP", "LVDS"))), None)


def destinations(outputs):
    active = [o["name"] for o in outputs if o.get("active")]
    internal = internal_output(outputs)
    if not internal:
        return None
    external = next((name for name in active if name != internal), internal)
    return internal, external


def reconcile(outputs, workspaces):
    target = destinations(outputs)
    if target is None:
        return False
    internal, external = target
    focused = next((w["name"] for w in workspaces if w.get("focused")), None)
    moves = []
    for ws in workspaces:
        number = ws.get("num", -1)
        if number == 0:
            output = internal
        elif 1 <= number <= 5:
            output = external
        else:
            continue
        if ws["output"] != output:
            moves.append((ws["name"], output))
    if not moves:
        return False

    # Moving a workspace changes focus. Restore the originally focused
    # workspace once the layout has converged.
    for name, output in moves:
        i3(f'workspace "{name}"; move workspace to output "{output}"')
    if focused is not None:
        i3(f'workspace "{focused}"')
    return True


def main():
    logging.basicConfig(level=logging.WARNING)
    while True:
        try:
            reconcile(state("outputs"), state("workspaces"))
        except (OSError, subprocess.CalledProcessError, ValueError, KeyError) as error:
            LOG.warning("Unable to synchronize workspace outputs: %s", error)
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
