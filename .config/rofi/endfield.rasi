@import "../theme/endfield.rasi"

/* Corners are square: rasi has no clip and no gradient, so the 45 degree cut
 * this language uses instead of a radius cannot be drawn here at all. Rounding
 * would be the one surface still speaking the old dialect. */

* {
    background-color: transparent;
    text-color:       @text-secondary;
    font:             "HarmonyOS Sans 12";
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    background-color: @bg-panel;
    border:           2px;
    border-color:     @accent;
    border-radius:    0;
    location:         center;
    width:            34%;
    height:           56%;
    padding:          16px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  12px;
}

/* The query is a well, not a plate: it sinks below the window the way every
 * other input in this language does. */
inputbar {
    background-color: @bg-deep;
    border-radius:    0;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "";
    placeholder-color: @text-muted;
    text-color:        @text-primary;
}

message {
    background-color: @bg-raised;
    border-radius:    0;
    padding:          8px 16px;
}

listview {
    lines:        10;
    columns:      1;
    scrollbar:    false;
    fixed-height: false;
    spacing:      4px;
}

element {
    border-radius: 0;
    padding:       8px 12px;
    spacing:       12px;
}

element normal.normal {
    text-color: @text-secondary;
}

element alternate.normal {
    text-color: @text-secondary;
}

/* The banner, as far as rasi reaches. rofi has one background-image slot, so
 * this is the trailing bands or the hatch and not both; the bands are the
 * shape, the hatch is only the material.
 *
 * Drawn as an image rather than a gradient. rasi takes colour stops but not
 * positions, and adding transparent stops to push the bands rightward barely
 * moves them — its placement is not the even distribution it looks like.
 *
 * The mode is "width" and not "both". In rofi "both" means contain: it fits
 * the image inside the row and leaves whatever is left over showing plain
 * accent, and it reaches that fit by squeezing one axis harder than the other,
 * which turns the diagonals into a staircase. "width" scales uniformly until
 * the image spans the row and crops the overflow.
 *
 * Regenerate with theme/rofi-tail.py if the proportion changes. */
element selected.normal {
    background-color: @accent;
    text-color:       @on-accent;
    background-image: url("/home/nyxze/.config/theme/rofi-tail.png", width);
}

element urgent.normal {
    text-color: @danger;
}

/* Already running, as opposed to merely selected. */
element active.normal {
    text-color: @info;
}

element selected.active {
    background-color: @info;
    text-color:       @on-accent;
}

element-icon {
    size:              24px;
    vertical-align:    0.5;
    background-color:  transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}
