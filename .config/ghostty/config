# Ghostty for this desktop. The palette lives in themes/endfield; everything
# here is the material and the spacing around it.

theme = endfield

font-family = "NotoMono Nerd Font"
font-size = 12
# Loosens the leading the way the shell does for body text: a terminal set
# solid reads as a wall, and this is the only knob for it.
adjust-cell-height = 12%

# No ground, and that is a decision rather than an omission. Every material in
# the theme was tried here — the grid, the hatch, a dot screen at four
# strengths, contours, registration marks, a tube's scanline and grain — and
# each one either vanished or got in the way. This is the one surface whose
# content is itself a grid of glyphs, read for hours at a time: a texture
# behind it has no correct amplitude, only a least bad one.
#
# The terminal wears the palette, the cell height and the padding. That is its
# share of the language.

# Text does not start on the frame. The horizontal step is wider than the
# vertical one because a line of text needs room to the left of it, not above.
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-padding-color = background
gtk-titlebar = false

cursor-style = bar
cursor-style-blink = true
# The bar at the emphasis border's weight, the same 2px the shell uses to say
# "this one has focus".
adjust-cursor-thickness = 1
mouse-hide-while-typing = true

# Bold is weight, not another colour: letting it swap in the bright variant
# would put a second yellow on screen that the palette never chose.
bold-is-bright = false

# Chrome, not content: the GTK bits (tab bar, menus) follow the desktop's dark
# theme, and the size readout that floats over a resize is stock furniture
# from nowhere.
window-theme = dark
resize-overlay = never

# A split that is not focused is still being read. The default dims it by a
# third, which is a lot for text.
unfocused-split-opacity = 0.92

shell-integration-features = ssh-terminfo, no-cursor

keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
keybind = ctrl+F4=close_tab
keybind = ctrl+enter=unbind
keybind = ctrl+tab=text:\x1b[9;5u
