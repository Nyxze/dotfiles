# Endfield palette for ghostty.
#
# ANSI needs eight hues; the desktop palette defines four. Magenta and cyan are
# therefore derived to sit on the same lightness and chroma band as the blue,
# so a colourised diff or ls does not break register with the rest of the desk.

background = #0B1118
foreground = #E8EDF1
cursor-color = #FFD400
selection-background = #1B2733
selection-foreground = #E8EDF1

palette = 0=#1B2733
