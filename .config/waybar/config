{
    "include": [
        "$HOME/.config/waybar/Modules",
        "$HOME/.config/waybar/ModulesGroups"
    ],
    "layer": "top",
    "reload_style_on_change": true,
    "position": "top",
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": false,
        "format": "{icon}",
        "show-special": false,
        "on-click": "activate",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "qs -c endfield ipc call sidebar page power",
        "tooltip": true,
        "tooltip-format": "Session"
    },
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "group/status",
        "custom/control",
        "clock",
        "tray",
        "custom/power"
    ],
    "custom/control": {
        "format": "󰒓",
        "on-click": "qs -c endfield ipc call sidebar toggle",
        "tooltip": true,
        "tooltip-format": "Control centre"
    }
}
