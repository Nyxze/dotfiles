/* Endfield palette for rofi.
 *
 * Every name here has to stay clear of rofi's own property names: a global
 * block sets properties as well as variables, so a variable called `border`
 * or `padding` would silently draw one. */

* {
    bg-deep:        #0B1118;
    bg-panel:       #111A23;
    bg-raised:      #1B2733;
    line:           #3A4A59;

    text-primary:   #E8EDF1;
    text-secondary: #AAB7C2;
    text-muted:     #8A99A6;

    accent:         #FFD400;
    accent-soft:    #FFE14D;

    info:           #4B9BFF;
    success:        #8BD32E;
    danger:         #FF6B45;

    on-accent:      #0B1118;
}
