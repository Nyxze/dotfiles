#!/bin/bash
# Machine -> repository, for capturing what an application wrote on its own.
# ./deploy runs the other way and is what hand edits should go through, since
# the repository is the source of truth.

# Both directions delete, so each refuses to run while the other side holds
# something it would destroy.
#
# A checksum difference is symmetric and says nothing about which side moved,
# so the modification time breaks the tie — but only one way. A copy preserves
# the source mtime, so a same-second edit on the other side lands on an equal
# timestamp and no comparison can separate them. Anything not strictly older
# than its destination therefore counts as unreplayed: when the content differs
# and the clock cannot say who moved, refusing is the only safe answer.
# Working documents belong to the repository, not to the machine: they are
# never copied out, and never deleted from the repository just because the
# machine has no copy. --delete skips whatever is excluded, so the exclusion
# protects them in both directions at once.
# Applications that own their configuration directory apart from a few files.
# Mirroring the whole thing would carry caches, history and vendored packages,
# so only these paths move and neither side ever deletes.
declare -A SCOPED=(
    [Code]="User/settings.json User/keybindings.json User/mcp.json"
    [opencode]="opencode.json"
)

# Copies the listed paths one by one, refusing any whose destination is not
# strictly older — the same rule the directory guard applies, per file.
copy_scoped() {
    local label="$1" src="$2" dst="$3"; shift 3
    local rel blocked=0 moved=0
    for rel in "$@"; do
        [ -e "$src/$rel" ] || continue
        if [ -e "$dst/$rel" ] && ! cmp -s "$src/$rel" "$dst/$rel" \
           && [ ! "$src/$rel" -nt "$dst/$rel" ]; then
            echo "✗ $label: $rel differs and the destination is not older."
            blocked=1
            continue
        fi
        mkdir -p "$dst/$(dirname "$rel")"
        rsync -a "$src/$rel" "$dst/$rel"
        moved=$((moved + 1))
    done
    [ $blocked = 0 ] || { FAILED=1; return 1; }
    echo "✓ $label ($moved file(s))"
}

# Design references stay in the repository; icon-theme.cache is generated by
# the machine and should not be copied into the repository.
DOCS=(--exclude=AGENTS.md --exclude=DESIGN.md --exclude=README.md
      --exclude=TODO.md --exclude=CLAUDE.md --exclude='*.pdf'
      --exclude=icon-theme.cache)

pending() {
    local src="$1" dst="$2" rel out=""
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        [ -e "$dst/$rel" ] || continue
        if [ ! -e "$src/$rel" ]; then
            out+="$rel (exists only there)"$'\n'
        elif [ ! "$src/$rel" -nt "$dst/$rel" ]; then
            out+="$rel"$'\n'
        fi
    done < <(rsync -rn -i --delete --checksum "${DOCS[@]}" "$src/" "$dst/" 2>/dev/null \
                 | grep -E '^(>|<|\*deleting)' | sed -E 's/^\S+[[:space:]]+//')
    printf '%s' "$out"
}

guard() {
    local label="$1" src="$2" dst="$3" lost
    [ -d "$dst" ] || return 0
    lost=$(pending "$src" "$dst")
    [ -n "$lost" ] || return 0

    echo "✗ $label: the repository holds changes the machine does not."
    echo "$lost" | sed 's/^/    /'
    echo "  Deploying them first: ./deploy $label,"
    echo "  or pass --force to discard them."
    return 1
}

sync_config() {
    local repo_config="$1"
    local home_config="$HOME/.config"
    local apps=("${@:2}")

    if [ ${#apps[@]} -eq 0 ]; then
        for dir in "$repo_config"/*/; do
            [ -d "$dir" ] || continue
            apps+=("$(basename "$dir")")
        done
    fi

    for app in "${apps[@]}"; do
        local source="$home_config/$app"
        local dest="$repo_config/$app"

        if [ ! -d "$dest" ]; then
            echo "✗ $app: Not tracked in repo"
            continue
        fi

        if [ -n "${SCOPED[$app]+x}" ]; then
            copy_scoped "$app" "$source" "$dest" ${SCOPED[$app]}
            continue
        fi

        if [ ! -d "$source" ]; then
            echo "✗ $app: Source directory not found: $source"
            continue
        fi

        [ "$FORCE" = 1 ] || guard "$app" "$source" "$dest" || { FAILED=1; continue; }
        echo "Syncing $app..."
        rsync -av --delete "${DOCS[@]}" "$source/" "$dest/"
        echo "✓ $app synced"
    done
}

sync_scripts() {
    local repo_scripts="$1"
    local home_scripts="$HOME/.local/scripts"

    [ "$FORCE" = 1 ] || guard "scripts" "$home_scripts" "$repo_scripts" || { FAILED=1; return; }
    echo "Syncing scripts..."
    rsync -av --delete "${DOCS[@]}" "$home_scripts/" "$repo_scripts/"
    echo "✓ scripts synced"
}

# Only the theme this repository owns. The rest of ~/.local/share/icons is
# whatever applications dropped there.
sync_icons() {
    local repo_icons="$1"
    local home_icons="$HOME/.local/share/icons/endfield"

    [ "$FORCE" = 1 ] || guard "icons" "$home_icons" "$repo_icons" || { FAILED=1; return; }
    echo "Syncing icons..."
    rsync -av --delete "${DOCS[@]}" "$home_icons/" "$repo_icons/"
    echo "✓ icons synced"
}

sync_files() {
    local repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    if [ "$1" == "scripts" ]; then
        sync_scripts "$repo_root/.local/scripts"
    elif [ "$1" == "icons" ]; then
        sync_icons "$repo_root/.local/share/icons/endfield"
    elif [ $# -gt 0 ]; then
        sync_config "$repo_root/.config" "$@"
    else
        sync_config "$repo_root/.config"
        sync_scripts "$repo_root/.local/scripts"
        sync_icons "$repo_root/.local/share/icons/endfield"
    fi
}

FORCE=0
FAILED=0
args=()
for a in "$@"; do
    [ "$a" == "--force" ] && FORCE=1 || args+=("$a")
done

sync_files "${args[@]}"
exit $FAILED
